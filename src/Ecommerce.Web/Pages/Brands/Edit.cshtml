@page "{id:int}"
@model Ecommerce.Web.Pages.Brands.EditModel
@{
    ViewData["Title"] = "Edit Brand";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="bi bi-pencil"></i> Edit Brand</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Brand.BrandId" />
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Brand.BrandName" class="form-label"></label>
                            <input asp-for="Brand.BrandName" class="form-control" />
                            <span asp-validation-for="Brand.BrandName" class="text-danger"></span>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <button type="submit" class="btn btn-info">
                                    <i class="bi bi-save"></i> Save Changes
                                </button>
                                <a asp-page="Details" asp-route-id="@Model.Brand.BrandId" class="btn btn-warning">
                                    <i class="bi bi-eye"></i> View Details
                                </a>
                                <a asp-page="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-info-circle"></i> Edit Information</h5>
                    <ul class="list-unstyled">
                        <li><strong>Brand ID:</strong> @Model.Brand.BrandId</li>
                        <li><strong>Last Modified:</strong> @DateTime.Now.ToString("g")</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
