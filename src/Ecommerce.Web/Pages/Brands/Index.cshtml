@page
@model Ecommerce.Web.Pages.Brands.IndexModel
@{
    ViewData["Title"] = "Brands";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="bi bi-bookmark-star"></i> Brands</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-page="Create" class="btn btn-info">
                <i class="bi bi-plus-circle"></i> Add New Brand
            </a>
        </div>
    </div>

    @if (Model.Brands.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-info">
                            <tr>
                                <th>ID</th>
                                <th>Brand Name</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var brand in Model.Brands)
                            {
                                <tr>
                                    <td>@brand.BrandId</td>
                                    <td><strong>@brand.BrandName</strong></td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-page="Details" asp-route-id="@brand.BrandId" class="btn btn-sm btn-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-page="Edit" asp-route-id="@brand.BrandId" class="btn btn-sm btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-page="Delete" asp-route-id="@brand.BrandId" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <p class="text-muted">Showing @Model.Brands.Count() brand(s)</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No brands found. <a asp-page="Create">Create a new brand</a>
        </div>
    }
</div>
