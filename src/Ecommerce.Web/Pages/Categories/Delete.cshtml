@page "{id:int}"
@model Ecommerce.Web.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-danger"><i class="bi bi-trash"></i> Delete Category</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="alert alert-danger">
                <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Confirm Deletion</h4>
                <p>Are you sure you want to delete this category? This action cannot be undone.</p>
            </div>

            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">@Model.Category.CategoryName</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4"><strong>Category ID:</strong></div>
                        <div class="col-md-8">@Model.Category.CategoryId</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4"><strong>Description:</strong></div>
                        <div class="col-md-8">@(Model.Category.Description ?? "N/A")</div>
                    </div>

                    <hr />

                    <form method="post">
                        <input type="hidden" asp-for="Category.CategoryId" />
                        <div class="row mt-4">
                            <div class="col-12">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Confirm Delete
                                </button>
                                <a asp-page="Details" asp-route-id="@Model.Category.CategoryId" class="btn btn-info">
                                    <i class="bi bi-eye"></i> View Details
                                </a>
                                <a asp-page="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-exclamation-triangle"></i> Warning</h5>
                    <p class="card-text">Deleting this category will permanently remove it from the database.</p>
                    <p class="card-text">This action cannot be undone.</p>
                </div>
            </div>
        </div>
    </div>
</div>
