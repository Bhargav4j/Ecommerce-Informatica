@page "{id:int}"
@model Ecommerce.Web.Pages.Categories.EditModel
@{
    ViewData["Title"] = "Edit Category";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="bi bi-pencil"></i> Edit Category</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Category.CategoryId" />
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Category.CategoryName" class="form-label"></label>
                            <input asp-for="Category.CategoryName" class="form-control" />
                            <span asp-validation-for="Category.CategoryName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category.Description" class="form-label"></label>
                            <textarea asp-for="Category.Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Category.Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category.PictureFile" class="form-label"></label>
                            <input asp-for="Category.PictureFile" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="Category.PictureFile" class="text-danger"></span>
                            <div class="form-text">Upload a new image to replace the current one (optional)</div>
                            @if (Model.Category.Picture != null)
                            {
                                <div class="mt-2">
                                    <small class="text-muted">Current image: @Model.Category.Picture.Length bytes</small>
                                </div>
                            }
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-save"></i> Save Changes
                                </button>
                                <a asp-page="Details" asp-route-id="@Model.Category.CategoryId" class="btn btn-info">
                                    <i class="bi bi-eye"></i> View Details
                                </a>
                                <a asp-page="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-info-circle"></i> Edit Information</h5>
                    <ul class="list-unstyled">
                        <li><strong>Category ID:</strong> @Model.Category.CategoryId</li>
                        <li><strong>Last Modified:</strong> @DateTime.Now.ToString("g")</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
