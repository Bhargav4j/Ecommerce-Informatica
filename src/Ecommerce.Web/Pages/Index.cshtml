@page
@model Ecommerce.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <div class="jumbotron bg-light p-5 rounded">
                <h1 class="display-4">
                    <i class="bi bi-cart-fill text-primary"></i> Ecommerce Management System
                </h1>
                <p class="lead">Welcome to the comprehensive e-commerce management platform</p>
                <hr class="my-4">
                <p>Manage your products, categories, brands, suppliers, and more from a single interface.</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm hover-card">
                <div class="card-body text-center">
                    <i class="bi bi-box-seam display-1 text-primary"></i>
                    <h5 class="card-title mt-3">Products</h5>
                    <p class="card-text">Manage your product catalog, inventory, and pricing</p>
                    <a asp-page="/Products/Index" class="btn btn-primary">
                        <i class="bi bi-arrow-right-circle"></i> View Products
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm hover-card">
                <div class="card-body text-center">
                    <i class="bi bi-tags display-1 text-success"></i>
                    <h5 class="card-title mt-3">Categories</h5>
                    <p class="card-text">Organize products into meaningful categories</p>
                    <a asp-page="/Categories/Index" class="btn btn-success">
                        <i class="bi bi-arrow-right-circle"></i> View Categories
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm hover-card">
                <div class="card-body text-center">
                    <i class="bi bi-bookmark-star display-1 text-info"></i>
                    <h5 class="card-title mt-3">Brands</h5>
                    <p class="card-text">Manage product brands and manufacturers</p>
                    <a asp-page="/Brands/Index" class="btn btn-info">
                        <i class="bi bi-arrow-right-circle"></i> View Brands
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm hover-card">
                <div class="card-body text-center">
                    <i class="bi bi-truck display-1 text-warning"></i>
                    <h5 class="card-title mt-3">Suppliers</h5>
                    <p class="card-text">Track and manage your supplier relationships</p>
                    <a asp-page="/Suppliers/Index" class="btn btn-warning">
                        <i class="bi bi-arrow-right-circle"></i> View Suppliers
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm hover-card">
                <div class="card-body text-center">
                    <i class="bi bi-people display-1 text-danger"></i>
                    <h5 class="card-title mt-3">Persons</h5>
                    <p class="card-text">Manage employee and contact information</p>
                    <a asp-page="/Persons/Index" class="btn btn-danger">
                        <i class="bi bi-arrow-right-circle"></i> View Persons
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm hover-card">
                <div class="card-body text-center">
                    <i class="bi bi-graph-up display-1 text-secondary"></i>
                    <h5 class="card-title mt-3">Reports</h5>
                    <p class="card-text">View analytics and generate reports</p>
                    <a href="#" class="btn btn-secondary disabled">
                        <i class="bi bi-arrow-right-circle"></i> Coming Soon
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-info-circle"></i> System Information
                    </h5>
                    <p class="mb-1"><strong>Version:</strong> 1.0.0</p>
                    <p class="mb-1"><strong>Framework:</strong> .NET 8.0</p>
                    <p class="mb-0"><strong>Logged in as:</strong> @User.Identity?.Name</p>
                </div>
            </div>
        </div>
    </div>
</div>
