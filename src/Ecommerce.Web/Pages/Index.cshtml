@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to E-commerce</h1>
    <p>Modern .NET 8 E-commerce Application</p>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Products</h5>
                <p class="card-text">Manage your product catalog</p>
                <a asp-page="/Products/Index" class="btn btn-primary">View Products</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Customers</h5>
                <p class="card-text">Manage customer information</p>
                <a asp-page="/Customers/Index" class="btn btn-primary">View Customers</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Invoices</h5>
                <p class="card-text">View and manage invoices</p>
                <a asp-page="/Invoices/Index" class="btn btn-primary">View Invoices</a>
            </div>
        </div>
    </div>
</div>
