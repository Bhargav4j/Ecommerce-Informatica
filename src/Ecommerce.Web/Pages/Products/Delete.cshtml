@page "{id:int}"
@model Ecommerce.Web.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Delete Product";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-danger">
                <i class="bi bi-trash"></i> Delete Product
            </h2>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="alert alert-danger">
                <h4 class="alert-heading">
                    <i class="bi bi-exclamation-triangle-fill"></i> Confirm Deletion
                </h4>
                <p>Are you sure you want to delete this product? This action cannot be undone.</p>
            </div>

            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">@Model.Product.ProductName</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Product ID:</strong>
                        </div>
                        <div class="col-md-8">
                            @Model.Product.ProductId
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Category:</strong>
                        </div>
                        <div class="col-md-8">
                            @Model.Product.CategoryName
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Supplier:</strong>
                        </div>
                        <div class="col-md-8">
                            @Model.Product.SupplierName
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Brand:</strong>
                        </div>
                        <div class="col-md-8">
                            @(Model.Product.BrandName ?? "N/A")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Unit Price:</strong>
                        </div>
                        <div class="col-md-8">
                            @Model.Product.UnitPrice.ToString("C")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Units In Stock:</strong>
                        </div>
                        <div class="col-md-8">
                            @Model.Product.UnitsInStock
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Status:</strong>
                        </div>
                        <div class="col-md-8">
                            @if (Model.Product.Discontinued)
                            {
                                <span class="badge bg-danger">Discontinued</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </div>
                    </div>

                    <hr />

                    <form method="post">
                        <input type="hidden" asp-for="Product.ProductId" />
                        <div class="row mt-4">
                            <div class="col-12">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Confirm Delete
                                </button>
                                <a asp-page="Details" asp-route-id="@Model.Product.ProductId" class="btn btn-info">
                                    <i class="bi bi-eye"></i> View Details
                                </a>
                                <a asp-page="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-exclamation-triangle"></i> Warning
                    </h5>
                    <p class="card-text">
                        Deleting this product will permanently remove it from the database.
                    </p>
                    <p class="card-text">
                        This action cannot be undone. Make sure you really want to delete this product.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
