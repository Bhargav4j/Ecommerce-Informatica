@page
@model Ecommerce.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<div class="mb-3">
    <form method="get" class="row g-3">
        <div class="col-auto">
            <input type="text" class="form-control" name="searchTerm" placeholder="Search products..." value="@Model.SearchTerm" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
        <div class="col-auto">
            <a asp-page="/Products/Create" class="btn btn-success">Add New Product</a>
        </div>
    </form>
</div>

@if (Model.Products != null && Model.Products.Any())
{
    <div class="row">
        @foreach (var product in Model.Products)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Description" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-white">No Image</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@product.Description</h5>
                        <p class="card-text">
                            <strong>Brand:</strong> @product.BrandName<br />
                            <strong>Category:</strong> @product.CategoryName<br />
                            <strong>Price:</strong> $@product.UnitPrice<br />
                            <strong>Stock:</strong> @product.Stock
                        </p>
                        <div class="btn-group" role="group">
                            <a asp-page="/Products/Details" asp-route-id="@product.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-page="/Products/Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-page="/Products/Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="alert alert-info">No products found.</p>
}
