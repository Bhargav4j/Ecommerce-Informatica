@page
@model Ecommerce.Web.Pages.Suppliers.IndexModel
@{
    ViewData["Title"] = "Suppliers";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="bi bi-truck"></i> Suppliers</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-page="Create" class="btn btn-warning">
                <i class="bi bi-plus-circle"></i> Add New Supplier
            </a>
        </div>
    </div>

    @if (Model.Suppliers.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-warning">
                            <tr>
                                <th>ID</th>
                                <th>Company Name</th>
                                <th>Contact Name</th>
                                <th>City</th>
                                <th>Country</th>
                                <th>Phone</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var supplier in Model.Suppliers)
                            {
                                <tr>
                                    <td>@supplier.SupplierId</td>
                                    <td><strong>@supplier.CompanyName</strong></td>
                                    <td>@(supplier.ContactName ?? "N/A")</td>
                                    <td>@(supplier.City ?? "N/A")</td>
                                    <td>@(supplier.Country ?? "N/A")</td>
                                    <td>@(supplier.Phone ?? "N/A")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-page="Details" asp-route-id="@supplier.SupplierId" class="btn btn-sm btn-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-page="Edit" asp-route-id="@supplier.SupplierId" class="btn btn-sm btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-page="Delete" asp-route-id="@supplier.SupplierId" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <p class="text-muted">Showing @Model.Suppliers.Count() supplier(s)</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No suppliers found. <a asp-page="Create">Create a new supplier</a>
        </div>
    }
</div>
