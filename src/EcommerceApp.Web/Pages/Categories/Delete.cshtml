@page "{id:int}"
@model EcommerceApp.Web.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
}

<h1>Delete Category</h1>

<h3>Are you sure you want to delete this category?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Category!.Id</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Category.Name</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Category.Description</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(Model.Category.IsActive ? "Active" : "Inactive")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Category!.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
