@page "{id:int}"
@model EcommerceApp.Web.Pages.Categories.DetailsModel
@{
    ViewData["Title"] = "Category Details";
}

<h1>Category Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Category!.Id</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Category.Name</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Category.Description</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(Model.Category.IsActive ? "Active" : "Inactive")</dd>
    </dl>
</div>
<div>
    <a asp-page="Edit" asp-route-id="@Model.Category.Id" class="btn btn-warning">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</div>
