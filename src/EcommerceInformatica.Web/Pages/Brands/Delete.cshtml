@page
@model EcommerceInformatica.Web.Pages.Brands.DeleteModel
@{
    ViewData["Title"] = "Delete Brand";
}

<div class="row">
    <div class="col-md-12">
        <h1>Delete Brand</h1>
        <hr />
    </div>
</div>

@if (Model.Brand != null)
{
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this brand?</h4>
    </div>

    <div class="row">
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Brand.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Brand.Description</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Brand.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">@Model.Brand.CreatedDate.ToString("g")</dd>
            </dl>

            <form method="post">
                <input type="hidden" asp-for="Brand.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        Brand not found.
    </div>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
