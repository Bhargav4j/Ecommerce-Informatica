@page
@model EcommerceInformatica.Web.Pages.Brands.DetailsModel
@{
    ViewData["Title"] = "Brand Details";
}

<div class="row">
    <div class="col-md-12">
        <h1>Brand Details</h1>
        <hr />
    </div>
</div>

@if (Model.Brand != null)
{
    <div class="row">
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Brand.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Brand.Description</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Brand.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">@Model.Brand.CreatedDate.ToString("g")</dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9">@Model.Brand.CreatedBy</dd>

                @if (Model.Brand.ModifiedDate.HasValue)
                {
                    <dt class="col-sm-3">Modified Date</dt>
                    <dd class="col-sm-9">@Model.Brand.ModifiedDate.Value.ToString("g")</dd>

                    <dt class="col-sm-3">Modified By</dt>
                    <dd class="col-sm-9">@Model.Brand.ModifiedBy</dd>
                }
            </dl>

            <div class="mt-3">
                <a asp-page="Edit" asp-route-id="@Model.Brand.Id" class="btn btn-warning">Edit</a>
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        Brand not found.
    </div>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
