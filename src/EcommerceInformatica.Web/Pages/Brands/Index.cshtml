@page
@model EcommerceInformatica.Web.Pages.Brands.IndexModel
@{
    ViewData["Title"] = "Brands";
}

<div class="row">
    <div class="col-md-12">
        <h1>Brands</h1>
        <hr />
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <a asp-page="Create" class="btn btn-primary">Create New Brand</a>
    </div>
    <div class="col-md-6">
        <form method="get" class="d-flex">
            <input type="text" name="searchString" value="@Model.SearchString" class="form-control me-2" placeholder="Search brands..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </form>
    </div>
</div>

@if (Model.Brands.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Created Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var brand in Model.Brands)
                {
                    <tr>
                        <td>@brand.Name</td>
                        <td>@brand.Description</td>
                        <td>
                            @if (brand.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>@brand.CreatedDate.ToString("d")</td>
                        <td>
                            <a asp-page="Details" asp-route-id="@brand.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-page="Edit" asp-route-id="@brand.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-page="Delete" asp-route-id="@brand.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        No brands found. <a asp-page="Create">Create a new brand</a>
    </div>
}
