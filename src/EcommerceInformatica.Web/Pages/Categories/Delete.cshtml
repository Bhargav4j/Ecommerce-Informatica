@page
@model EcommerceInformatica.Web.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
}

<div class="row">
    <div class="col-md-12">
        <h1>Delete Category</h1>
        <hr />
    </div>
</div>

@if (Model.Category != null)
{
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this category?</h4>
    </div>

    <div class="row">
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Category.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Category.Description</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Category.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">@Model.Category.CreatedDate.ToString("g")</dd>
            </dl>

            <form method="post">
                <input type="hidden" asp-for="Category.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        Category not found.
    </div>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
