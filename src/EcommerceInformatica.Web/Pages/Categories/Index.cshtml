@page
@model EcommerceInformatica.Web.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<div class="row">
    <div class="col-md-12">
        <h1>Categories</h1>
        <hr />
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <a asp-page="Create" class="btn btn-primary">Create New Category</a>
    </div>
    <div class="col-md-6">
        <form method="get" class="d-flex">
            <input type="text" name="searchString" value="@Model.SearchString" class="form-control me-2" placeholder="Search categories..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </form>
    </div>
</div>

@if (Model.Categories.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Created Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td>@category.Name</td>
                        <td>@category.Description</td>
                        <td>
                            @if (category.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>@category.CreatedDate.ToString("d")</td>
                        <td>
                            <a asp-page="Details" asp-route-id="@category.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-page="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-page="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        No categories found. <a asp-page="Create">Create a new category</a>
    </div>
}
