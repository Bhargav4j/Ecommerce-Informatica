@page
@model EcommerceInformatica.Web.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Delete Product";
}

<div class="row">
    <div class="col-md-12">
        <h1>Delete Product</h1>
        <hr />
    </div>
</div>

@if (Model.Product != null)
{
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this product?</h4>
    </div>

    <div class="row">
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Product.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Product.Description</dd>

                <dt class="col-sm-3">Unit Price</dt>
                <dd class="col-sm-9">@Model.Product.UnitPrice.ToString("C")</dd>

                <dt class="col-sm-3">Stock</dt>
                <dd class="col-sm-9">@Model.Product.Stock</dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.Product.CategoryName</dd>

                <dt class="col-sm-3">Brand</dt>
                <dd class="col-sm-9">@Model.Product.BrandName</dd>

                <dt class="col-sm-3">Supplier</dt>
                <dd class="col-sm-9">@Model.Product.SupplierName</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Product.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </dd>
            </dl>

            <form method="post">
                <input type="hidden" asp-for="Product.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        Product not found.
    </div>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
