@page
@model EcommerceInformatica.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
}

<div class="row">
    <div class="col-md-12">
        <h1>Products</h1>
        <hr />
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <a asp-page="Create" class="btn btn-primary">Create New Product</a>
    </div>
    <div class="col-md-6">
        <form method="get" class="d-flex">
            <input type="text" name="searchString" value="@Model.SearchString" class="form-control me-2" placeholder="Search products..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </form>
    </div>
</div>

@if (Model.Products.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td>@product.Description</td>
                        <td>@product.UnitPrice.ToString("C")</td>
                        <td>@product.Stock</td>
                        <td>@product.CategoryName</td>
                        <td>@product.BrandName</td>
                        <td>
                            @if (product.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-page="Details" asp-route-id="@product.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-page="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-page="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        No products found. <a asp-page="Create">Create a new product</a>
    </div>
}
